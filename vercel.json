{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ],
  "crons": [
    { "path": "/cron/pickup-reminders", "schedule": "0 12 * * *" }
  ]
}
