# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# MongoDB connection string. Use a separate database/cluster (or at minimum a
# separate database user) for production than for local development.
MONGO_URI=your_mongodb_connection_string

# The database name this server selects within the above connection string
# (see config/database.js / config/databaseName.js). Development uses
# sarabo-db (omit this var locally to fall back to it automatically). The
# automated test suite uses the isolated sarabo-test-db and refuses to run
# against sarabo-db or a production database. Production MUST use a separate
# database name of its own and must never reuse the development name - the
# server refuses to start otherwise.
MONGO_DB_NAME=sarabo-db

# Firebase Admin service account key, base64-encoded JSON (see
# config/firebase.js - it base64-decodes this value and JSON.parses it). Get
# the raw service account JSON from Firebase Console > Project Settings >
# Service Accounts, then base64-encode the whole file's contents.
FB_SERVICE_KEY=your_base64_encoded_firebase_service_account_json

# Stripe secret key. Use a test-mode (sk_test_...) key for local development
# and a live-mode (sk_live_...) key only in production - never share a key
# between the two.
STRIPE_SECRET=your_stripe_secret_key

# Stripe webhook signing secret for the /stripe-webhook endpoint (see
# routes/paymentWebhook.js). Each registered webhook endpoint (test-mode CLI
# forwarding, and the real production endpoint) has its own distinct signing
# secret - do not reuse one across environments.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# The client app's origin - used both as the production CORS allowlist entry
# (config/cors.js) and as the base for Stripe success/cancel redirect URLs
# (controllers/paymentController.js). Must be an origin only: no path, query
# string, or fragment. In production this must be an https:// URL and must
# not be localhost/127.0.0.1/::1 - see config/siteOrigin.js for the exact
# validation rules.
SITE_DOMAIN=http://localhost:5173

# Local listen port. Unused when deployed to Vercel (index.js skips
# app.listen() entirely when process.env.VERCEL is set).
PORT=3000

# Supabase Storage (Phase 9.1) - backs damage-evidence and repair-evidence
# image uploads. Replaces Firebase Storage, which requires the paid Blaze plan.
# Firebase is still the identity provider (FB_SERVICE_KEY above).
# SUPABASE_SERVICE_ROLE_KEY is the SECRET key (sb_secret_... or the service_role
# JWT) - it bypasses Row Level Security and must never reach a browser.
# The bucket must be PRIVATE; reads go through short-lived signed URLs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Customer Support AI. Phase 2 supports exactly one server-side provider:
# Google Gemini Developer API. Keep disabled until provider use and privacy
# terms are approved. Enabling still requires the settings below; missing or invalid
# optional-AI configuration fails closed without preventing server startup.
AI_SUPPORT_ENABLED=false
AI_SUPPORT_PROVIDER=gemini
AI_SUPPORT_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
AI_SUPPORT_TIMEOUT_MS=22000
AI_SUPPORT_PROVIDER_MAX_ATTEMPTS=2
AI_SUPPORT_RETRY_BASE_DELAY_MS=600
AI_SUPPORT_RETRY_MAX_DELAY_MS=1000
AI_SUPPORT_MAX_OUTPUT_TOKENS=400
AI_SUPPORT_MESSAGE_MAX_CHARS=1500
AI_SUPPORT_HISTORY_MAX_MESSAGES=8
AI_SUPPORT_HISTORY_MESSAGE_MAX_CHARS=1500
AI_SUPPORT_HISTORY_MAX_CHARS=6000
AI_SUPPORT_OUTPUT_MAX_CHARS=4000

# Rate limits. Counters are stored in MongoDB (support_rate_limits) and shared
# by every instance; if the database is unreachable the chat is refused (503).
AI_SUPPORT_ANON_10M_LIMIT=8
AI_SUPPORT_ANON_DAILY_LIMIT=30
AI_SUPPORT_AUTH_10M_LIMIT=20
AI_SUPPORT_AUTH_DAILY_LIMIT=100
AI_SUPPORT_AUTH_IP_10M_LIMIT=60
AI_SUPPORT_AUTH_IP_DAILY_LIMIT=300
# Site-wide AI questions per UTC day, across all visitors.
AI_SUPPORT_GLOBAL_DAILY_LIMIT=300

# Pickup scheduling: how many pickups each region can take in one 2-hour slot.
PICKUP_SLOT_CAPACITY=3

# Email updates (free, via a Gmail account). Off unless EMAIL_ENABLED=true.
# GMAIL_APP_PASSWORD is a Google "App password", NOT the normal Gmail password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_ENABLED=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Sarabo
# Secret that Vercel Cron sends to /cron/pickup-reminders. Any long random string.
CRON_SECRET=
